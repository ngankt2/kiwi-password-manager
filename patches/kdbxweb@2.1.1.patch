+++ b/dist/kiro-compression.cjs
@@ -0,0 +1,23 @@
+// Application integration patch: use maintained fflate with bounded streaming output.
+// No compression algorithm is implemented here.
+const { Gunzip, gzipSync } = require('fflate');
+const MAX_OUTPUT = 64 * 1024 * 1024;
+
+function gunzipSync(data) {
+  const chunks = [];
+  let length = 0;
+  const decoder = new Gunzip((chunk) => {
+    length += chunk.length;
+    if (length > MAX_OUTPUT) throw new Error('KDBX decompressed data exceeds the supported limit');
+    chunks.push(chunk);
+  });
+  for (let offset = 0; offset < data.length; offset += 1024) {
+    decoder.push(data.subarray(offset, offset + 1024), offset + 1024 >= data.length);
+  }
+  const result = new Uint8Array(length);
+  let offset = 0;
+  for (const chunk of chunks) { result.set(chunk, offset); offset += chunk.length; }
+  return result;
+}
+
+module.exports = { gunzipSync, gzipSync };
