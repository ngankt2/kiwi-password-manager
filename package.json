{
  "name": "appkiro-password-manager",
  "main": "expo-router/entry",
  "version": "1.0.30",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~57.0.19",
    "@tauri-apps/api": "^2.11.1",
    "@xmldom/xmldom": "0.9.12",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.22",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "lucide-react-native": "^1.47.0",
    "otpauth": "^9.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "bun run build:worker && expo start --dev-client",
    "android": "bun scripts/build-native.ts android --local",
    "ios": "bun scripts/build-native.ts ios --local",
    "web": "bun run build:worker && expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:native": "EXPO_PUBLIC_NATIVE_TESTS=1 expo start --dev-client --port 8083 --max-workers 2",
    "test:native:ui": "EXPO_PUBLIC_NATIVE_UI_TESTS=1 expo start --dev-client --port 8081 --max-workers 2",
    "build:mobile:cloud": "bun scripts/build-native.ts all --profile preview-simulator",
    "test:e2e": "playwright test",
    "build:worker": "esbuild workers/argon2.worker.ts --bundle --platform=browser --format=iife --minify --outfile=public/argon2.worker.js",
    "build:web": "bun scripts/build-web.ts",
    "preview:web": "expo serve --port 4180",
    "verify": "bun run lint && bun run typecheck && bun test",
    "build:desktop:web": "bun scripts/build-web.ts --desktop",
    "desktop:prepare": "bun scripts/build-desktop.ts --prepare",
    "desktop:start": "bun scripts/start-desktop.ts",
    "build:macos": "bun scripts/build-desktop.ts",
    "release:macos": "bun scripts/build-desktop.ts --publish",
    "publish:macos": "bun scripts/publish-desktop-release.ts",
    "build:ios": "bun scripts/build-native.ts ios",
    "build:ios:appstore": "bun scripts/build-native.ts ios --local --archive --team 943C9WTE6D",
    "build:android": "bun scripts/build-native.ts android",
    "build:native": "bun scripts/build-native.ts all",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:kdbx:local": "bun scripts/verify-kdbx.ts",
    "test:desktop:host": "cargo test --manifest-path desktop/tauri/Cargo.toml --lib --no-default-features",
    "test:desktop:native": "bun scripts/test-tauri-runtime.ts"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  },
  "private": true,
  "patchedDependencies": {
    "kdbxweb@2.1.1": "patches/kdbxweb@2.1.1.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch",
    "@expo/plist@0.8.1": "patches/@expo%2Fplist@0.8.1.patch"
  }
}
